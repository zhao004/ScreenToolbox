<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScreenToolbox" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/window_background_dark</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/brand_blue_dark</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.ScreenToolbox.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ScreenToolbox</item>
    </style>
</resources>
